<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI-framework agnostic: Twitch protocol, models and formatting live here
       so they stay unit-testable without Avalonia. -->
  <PropertyGroup>
    <RootNamespace>StreamEdge</RootNamespace>
    <AssemblyName>StreamEdge.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <!-- DPAPI for SecretStore on Windows. Referenced unconditionally so the
         build is the same everywhere; only called behind IsWindows(). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StreamEdge.Tests" />
  </ItemGroup>

</Project>
