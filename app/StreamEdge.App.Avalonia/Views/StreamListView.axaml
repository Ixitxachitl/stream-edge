<!-- The live list: followed channels (and open tabs that aren't), with
     channel search above. Docks left of, right of, above or below the
     video (drag its header), wherever it was left. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:StreamEdge.AvaloniaApp.Views"
             xmlns:em="using:StreamEdge.AvaloniaApp.Views.Emotes"
             xmlns:vm="using:StreamEdge.AvaloniaApp.ViewModels"
             xmlns:streams="using:StreamEdge.Streams"
             xmlns:se="using:StreamEdge"
             x:Class="StreamEdge.AvaloniaApp.Views.StreamListView"
             x:DataType="vm:MainViewModel">
    <Border Classes="pane">
    <DockPanel>
      <Border DockPanel.Dock="Top" Classes="paneHeader">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Classes="dragGrip" Text="⠿" ToolTip.Tip="Drag to move: drop on a side of the video" />
          <Button DockPanel.Dock="Right" Content="⇅" ToolTip.Tip="Change sort" Command="{Binding Streams.CycleSortCommand}" />
          <ToggleButton DockPanel.Dock="Right" Classes="pip" Content="◌ Offline" IsChecked="{Binding Streams.ShowOffline}"
                        ToolTip.Tip="Also list followed channels that are offline, most recently live first" />
          <Button DockPanel.Dock="Right" Content="⟳" ToolTip.Tip="Refresh the live list (and retry offline tabs)" Command="{Binding RefreshCommand}" />
          <TextBlock Text="{Binding Streams.Header}" ToolTip.Tip="{Binding Streams.HeaderTip}" />
        </DockPanel>
      </Border>
      <!-- Join any channel: suggestions as you type, as on twitch.tv. -->
      <Panel DockPanel.Dock="Top" Margin="8,6,8,4">
        <TextBox x:Name="ChannelSearchBox" Classes="channelSearch" Text="{Binding Search.Query}"
                 PlaceholderText="Search or join a channel" />
        <Popup x:Name="ChannelSuggestionPopup" PlacementTarget="{Binding #ChannelSearchBox}" Placement="BottomEdgeAlignedLeft"
               IsOpen="{Binding Search.IsOpen}" IsLightDismissEnabled="False">
          <Border Classes="suggestions below" MinWidth="{Binding #ChannelSearchBox.Bounds.Width}">
            <ListBox x:Name="ChannelSuggestionList" Classes="suggestions channels" Focusable="False"
                     ItemsSource="{Binding Search.Suggestions}" SelectedIndex="{Binding Search.SelectedIndex, Mode=TwoWay}" MaxHeight="320">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="streams:ChannelSuggestion">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Panel Classes="avatar">
                      <Border Classes="avatarPlaceholder">
                        <TextBlock Text="{Binding Initial}" />
                      </Border>
                      <em:RemoteImage Source="{Binding ProfileImage}" Stretch="UniformToFill">
                        <em:RemoteImage.Clip>
                          <EllipseGeometry Rect="0,0,28,28" />
                        </em:RemoteImage.Clip>
                      </em:RemoteImage>
                    </Panel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,6,0">
                      <TextBlock Classes="streamName" Text="{Binding DisplayName}" />
                      <TextBlock Classes="streamGame" Text="{Binding Detail}"
                                 IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <Ellipse Grid.Column="2" Classes="liveDot" IsVisible="{Binding ShowsLiveDot}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </Popup>
      </Panel>
      <Panel>
        <!-- Open channels the user doesn't follow head the list, live or not. -->
        <ListBox x:Name="StreamList" Classes="streams" ItemsSource="{Binding Streams.Items}" SelectedItem="{Binding Streams.Selected}"
                 IsVisible="{Binding !Streams.IsEmpty}"
                 Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:StreamItemViewModel">
              <!-- As in twitch.tv's followed channels: avatar, name over
                   game, live dot and viewers; the title is on hover, after
                   a pause (and not straight from row to row) so it doesn't
                   pop up under the wheel while the list scrolls past. -->
              <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Background="Transparent"
                    Classes.offline="{Binding !IsLive}" ToolTip.ShowDelay="1000" ToolTip.BetweenShowDelay="0">
                <ToolTip.Tip>
                  <StackPanel MaxWidth="360" Spacing="2">
                    <TextBlock Text="{Binding SharedText}" Foreground="{StaticResource SeAccent}" FontWeight="SemiBold"
                               IsVisible="{Binding IsSharedChat}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CardTitle}" TextWrapping="Wrap" />
                    <!-- "Live for 2.4h", or "Last live 3h ago · Game" when offline. -->
                    <TextBlock Text="{Binding Uptime}" Foreground="{StaticResource SeTextDim}"
                               FontSize="{StaticResource SeSmallFontSize}" />
                    <TextBlock Text="{Binding LabelsText}" IsVisible="{Binding HasLabels}" TextWrapping="Wrap"
                               Foreground="#FFB31A" FontSize="{StaticResource SeSmallFontSize}" />
                    <TextBlock Text="{Binding TagsText}" IsVisible="{Binding HasTags}" TextWrapping="Wrap"
                               Foreground="{StaticResource SeTextDim}" FontSize="{StaticResource SeSmallFontSize}" />
                  </StackPanel>
                </ToolTip.Tip>
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Open" Command="{Binding OpenCommand}" />
                    <MenuItem Header="Open in new tab" Command="{Binding OpenInNewTabCommand}" />
                    <MenuItem Header="Open in background tab" Command="{Binding OpenInBackgroundCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding FavoriteMenuText}" Command="{Binding ToggleFavoriteCommand}" />
                    <MenuItem Header="Follow or unfollow on twitch.tv" Command="{Binding OpenOnTwitchCommand}" />
                  </ContextMenu>
                </Grid.ContextMenu>
                <!-- The initial shows until the avatar loads, or if there is none. -->
                <Panel Classes="avatar">
                  <Border Classes="avatarPlaceholder">
                    <TextBlock Text="{Binding Initial}" />
                  </Border>
                  <em:RemoteImage Source="{Binding ProfileImage}" Stretch="UniformToFill">
                    <em:RemoteImage.Clip>
                      <EllipseGeometry Rect="0,0,30,30" />
                    </em:RemoteImage.Clip>
                  </em:RemoteImage>
                  <!-- Shared chat: the partners' icons over the corner. -->
                  <ItemsControl Classes="sharedAvatars" ItemsSource="{Binding SharedAvatars}" IsVisible="{Binding IsSharedChat}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="-6" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SharedAvatar">
                        <Border Classes="sharedAvatar">
                          <Panel>
                            <TextBlock Text="{Binding Initial}" />
                            <em:RemoteImage Source="{Binding Image}" Stretch="UniformToFill">
                              <em:RemoteImage.Clip>
                                <EllipseGeometry Rect="0,0,16,16" />
                              </em:RemoteImage.Clip>
                            </em:RemoteImage>
                          </Panel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Panel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,6,0">
                  <TextBlock Classes="streamName" Text="{Binding DisplayName}" />
                  <TextBlock Classes="streamGame" Text="{Binding Game}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Top" Margin="0,1,0,0">
                  <!-- Click to star: starred channels sort to the top. A
                       button, so clicking it doesn't also open the channel. -->
                  <Button Classes="star" Classes.on="{Binding IsFavorite}" Content="{Binding FavoriteGlyph}"
                          Command="{Binding ToggleFavoriteCommand}" ToolTip.Tip="{Binding FavoriteMenuText}" />
                  <Ellipse Classes="liveDot" IsVisible="{Binding IsLive}" />
                  <TextBlock Classes="streamViewers" Text="{Binding ViewersText}" />
                </StackPanel>
                <!-- Under the last open-but-unfollowed channel: followed ones below. -->
                <Border Grid.Row="1" Grid.ColumnSpan="3" Classes="listSeparator" IsVisible="{Binding SeparatorBelow}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <!-- After the list, so the login button sits over it and gets its
             clicks; it shows under any open-but-unfollowed channels. -->
        <StackPanel IsVisible="{Binding Streams.NoFollowed}" VerticalAlignment="Center" Margin="16" Spacing="10">
          <TextBlock Text="{Binding Streams.EmptyText}" Foreground="{StaticResource SeTextFaint}"
                     TextWrapping="Wrap" TextAlignment="Center" />
          <!-- The login screen: shown in place of the list until signed in. -->
          <v:LoginBox DataContext="{Binding Account}" IsVisible="{Binding !IsSignedIn}" HorizontalAlignment="Center" />
        </StackPanel>
      </Panel>
    </DockPanel>
    </Border>
</UserControl>
