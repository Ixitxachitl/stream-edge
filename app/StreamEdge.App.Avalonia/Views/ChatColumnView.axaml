<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:StreamEdge.AvaloniaApp.Views"
             xmlns:em="using:StreamEdge.AvaloniaApp.Views.Emotes"
             xmlns:vm="using:StreamEdge.AvaloniaApp.ViewModels"
             xmlns:emotes="using:StreamEdge.Chat.Emotes"
             xmlns:se="using:StreamEdge"
             x:Class="StreamEdge.AvaloniaApp.Views.ChatColumnView"
             x:DataType="vm:ChatColumnViewModel">
  <!-- One chat column; several sit side by side in the chat pane. -->
  <DockPanel Background="{StaticResource SePanelBg}">
    <Border DockPanel.Dock="Top" Classes="paneHeader">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Classes="dragGrip" Text="⠿" ToolTip.Tip="Drag to move: drop on a side of the video" />
        <!-- The app's own controls, on the last chat's toolbar: settings beside
             PIP, always here wherever the panes are docked. -->
        <Button DockPanel.Dock="Right" Classes="pip" IsVisible="{Binding IsLast}" ToolTip.Tip="Settings">
          <PathIcon Classes="icon" Data="{StaticResource IconGear}" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <v:SettingsView DataContext="{Binding Main}" />
            </Flyout>
          </Button.Flyout>
        </Button>
        <ToggleButton DockPanel.Dock="Right" Classes="pip" Content="⧉" IsChecked="{Binding Main.ShowPip}"
                      IsVisible="{Binding IsLast}"
                      ToolTip.Tip="Picture-in-picture: background tabs as small videos over the player (off: they pause until you switch to them)" />
        <!-- Which panes show (each moves by dragging its header). -->
        <Button DockPanel.Dock="Right" Classes="pip" Content="▦" IsVisible="{Binding IsLast}" ToolTip.Tip="Layout">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="Live list" ToggleType="CheckBox" IsChecked="{Binding Main.ShowStreamList, Mode=TwoWay}" />
              <MenuItem Header="About panels" ToggleType="CheckBox" IsChecked="{Binding Main.ShowChannelPanel, Mode=TwoWay}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <!-- Mod menu: only in channels the user moderates. -->
        <Button DockPanel.Dock="Right" x:Name="ModMenuButton" ToolTip.Tip="Moderation"
                IsVisible="{Binding Chat.IsModerator}">
          <PathIcon Classes="icon" Data="{StaticResource IconShield}" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Width="280" Spacing="8" DataContext="{Binding Main.ModMenu}" x:DataType="vm:ModMenuViewModel">
                <TextBlock Text="Chat modes" FontWeight="SemiBold" />
                <ToggleSwitch Content="Slow mode (30 s)" IsChecked="{Binding SlowMode}" />
                <ToggleSwitch Content="Followers only (10 min)" IsChecked="{Binding FollowersOnly}" />
                <ToggleSwitch Content="Subscribers only" IsChecked="{Binding SubscribersOnly}" />
                <ToggleSwitch Content="Emote only" IsChecked="{Binding EmoteOnly}" />
                <ToggleSwitch Content="Unique chat" IsChecked="{Binding UniqueChat}" />
                <ToggleSwitch Content="Shield mode" IsChecked="{Binding ShieldMode}" />
                <Separator />
                <TextBlock Text="Announcement" FontWeight="SemiBold" />
                <TextBox Text="{Binding Announcement}" PlaceholderText="Message" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ComboBox ItemsSource="{Binding AnnouncementColors}" SelectedItem="{Binding AnnouncementColor}" />
                  <Button Content="Announce" Command="{Binding AnnounceCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource SeAccent}"
                           IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Chat.Status}" Foreground="{StaticResource SeTextFaint}" Margin="0,0,6,0" />
        <!-- Player controls live here: nothing can be drawn over native video. -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" Margin="0,0,8,0">
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="HasFront" />
              <Binding Path="Main.Player.IsVideoVisible" />
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="{Binding Main.Player.Speed}" Foreground="{StaticResource SeAccent}"
                     ToolTip.Tip="Playing faster to catch up to live" Margin="0,0,4,0" />
          <TextBlock Text="{Binding Main.Player.Latency}" Foreground="{StaticResource SeTextDim}"
                     ToolTip.Tip="Approximate delay behind the broadcaster" Margin="0,0,4,0" />
          <ToggleButton Classes="cc" Content="CC" IsChecked="{Binding Main.Player.Captions}" ToolTip.Tip="Closed captions (when the stream has them)" />
          <Button Content="{Binding Main.Player.QualityLabel}" ToolTip.Tip="Quality (drops automatically to keep up with live)">
            <Button.Flyout>
              <MenuFlyout ItemsSource="{Binding Main.Qualities}">
                <MenuFlyout.ItemContainerTheme>
                  <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:QualityOption">
                    <Setter Property="Header" Value="{Binding Name}" />
                    <Setter Property="Command" Value="{Binding Select}" />
                    <Setter Property="CommandParameter" Value="{Binding}" />
                    <Setter Property="ToggleType" Value="Radio" />
                    <Setter Property="IsChecked" Value="{Binding IsCurrent}" />
                  </ControlTheme>
                </MenuFlyout.ItemContainerTheme>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        <!-- The channel's name, mute and close are on its tab. -->
        <Panel />
      </DockPanel>
    </Border>
    <!-- This column's channels. Clicking one shows its chat here and puts
         it on video; drag a tab to reorder it, move it to another column,
         or drop it on a column's edge to split it into a new column. -->
    <Border DockPanel.Dock="Top" Classes="tabStrip" IsVisible="{Binding HasTabs}">
      <DockPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Tabs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ChannelTabViewModel">
                <Border Classes="tab" Classes.selected="{Binding IsSelected}" Classes.front="{Binding IsFront}">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <!-- A TextBlock, not string content: that would take the
                         '_' in names like some_one for an access key. -->
                    <Button Classes="tabName" Command="{Binding SelectCommand}"
                            ToolTip.Tip="Show this channel (drag to move the tab)">
                      <TextBlock Text="{Binding Title}" />
                    </Button>
                    <Button Classes="tabIcon" Command="{Binding Player.ToggleMuteCommand}"
                            ToolTip.Tip="{Binding VolumeTip}">
                      <Panel>
                        <PathIcon Classes="icon" Data="{StaticResource IconSpeaker}" IsVisible="{Binding !Player.Muted}" />
                        <PathIcon Classes="icon" Data="{StaticResource IconMuted}" IsVisible="{Binding Player.Muted}" />
                      </Panel>
                    </Button>
                    <Button Classes="tabIcon" Content="✕" Command="{Binding CloseCommand}" ToolTip.Tip="Close tab" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <DockPanel DockPanel.Dock="Bottom" Margin="4">
      <!-- Emote menu, like twitch.tv's smiley in the chat box. Drawn, not the
           ☺ character: Windows shows that in its colour emoji font, and this
           stays a plain outline in the button's text colour everywhere. -->
      <Button DockPanel.Dock="Right" x:Name="EmoteButton" Classes="emoteMenu"
              ToolTip.Tip="Emotes" Margin="4,0,0,0">
        <Canvas Width="18" Height="18">
          <Ellipse Canvas.Left="1" Canvas.Top="1" Width="16" Height="16" StrokeThickness="1.5"
                   Stroke="{Binding $parent[Button].Foreground}" />
          <Ellipse Canvas.Left="5.5" Canvas.Top="6" Width="2" Height="2.5" Fill="{Binding $parent[Button].Foreground}" />
          <Ellipse Canvas.Left="10.5" Canvas.Top="6" Width="2" Height="2.5" Fill="{Binding $parent[Button].Foreground}" />
          <Path Data="M 5.5,11 Q 9,14.5 12.5,11" StrokeThickness="1.5" StrokeLineCap="Round"
                Stroke="{Binding $parent[Button].Foreground}" />
        </Canvas>
        <Button.Flyout>
          <Flyout Placement="TopEdgeAlignedRight">
            <DockPanel Width="344" DataContext="{Binding Main.EmoteMenu}" x:DataType="vm:EmoteMenuViewModel">
              <TextBox DockPanel.Dock="Top" x:Name="EmoteSearch" Text="{Binding Search}" PlaceholderText="Search emotes" />
              <TextBlock DockPanel.Dock="Top" Text="{Binding Notice}" TextWrapping="Wrap" Margin="2,6"
                         Foreground="{StaticResource SeTextDim}" FontSize="{StaticResource SeSmallFontSize}"
                         IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ListBox ItemsSource="{Binding Rows}" Classes="emoteRows" Height="300" Margin="0,6,0,0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.DataTemplates>
                  <DataTemplate DataType="vm:EmoteMenuHeader">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,8,0,2">
                      <em:RemoteImage Source="{Binding Icon}" Width="18" Height="18"
                                      IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <em:RemoteImage.Clip>
                          <EllipseGeometry Rect="0,0,18,18" />
                        </em:RemoteImage.Clip>
                      </em:RemoteImage>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource SeSmallFontSize}"
                                 Foreground="{StaticResource SeTextDim}" />
                    </StackPanel>
                  </DataTemplate>
                  <DataTemplate DataType="vm:EmoteMenuEmotes">
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EmoteMenuItem">
                          <Button Classes="emoteCell" Command="{Binding Insert}" CommandParameter="{Binding Emote}"
                                  ToolTip.Tip="{Binding Tip}">
                            <em:EmoteView Source="{Binding Emote.ImageUrl}" EmoteHeight="28" />
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DataTemplate>
                </ListBox.DataTemplates>
              </ListBox>
            </DockPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
      <!-- Channel points, like twitch.tv's button under the chat box:
           balance and the rewards on offer (redeeming opens twitch.tv). -->
      <Button DockPanel.Dock="Right" x:Name="PointsButton" Classes="emoteMenu" Margin="4,0,0,0"
              IsVisible="{Binding Chat.HasPoints}" ToolTip.Tip="{Binding Chat.PointsTip}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Panel Width="16" Height="16" VerticalAlignment="Center">
            <TextBlock Text="◉" FontSize="14" Foreground="#BF94FF" VerticalAlignment="Center"
                       IsVisible="{Binding Chat.Points.Icon, Converter={x:Static ObjectConverters.IsNull}, FallbackValue=True}" />
            <em:RemoteImage Source="{Binding Chat.Points.Icon, FallbackValue={x:Null}}" Stretch="Uniform" />
          </Panel>
          <TextBlock Text="{Binding Chat.BalanceText}" FontSize="{StaticResource SeSmallFontSize}" VerticalAlignment="Center"
                     IsVisible="{Binding Chat.BalanceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <Button.Flyout>
          <Flyout Placement="TopEdgeAlignedRight">
            <DockPanel Width="344" DataContext="{Binding Chat}" x:DataType="vm:ChatViewModel">
              <DockPanel DockPanel.Dock="Top" Margin="2,0,2,6">
                <TextBlock DockPanel.Dock="Right" Text="{Binding PointsTip}" FontSize="{StaticResource SeSmallFontSize}"
                           Foreground="{StaticResource SeTextDim}" VerticalAlignment="Center"
                           IsVisible="{Binding Points.Balance, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
                <TextBlock Text="{Binding Points.Name, FallbackValue=''}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <Button DockPanel.Dock="Bottom" Content="Redeem on twitch.tv ↗" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" Margin="0,6,0,0" x:Name="RedeemButton" />
              <TextBlock DockPanel.Dock="Bottom" Text="{Binding PointsNotice}" TextWrapping="Wrap" Margin="2,6,2,0"
                         Foreground="{StaticResource SeTextDim}" FontSize="{StaticResource SeSmallFontSize}" />
              <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Rewards}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel ItemWidth="84" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RewardTile">
                      <Border Margin="2" CornerRadius="4" Background="{Binding Background}" Height="96"
                              Opacity="{Binding Opacity}" ToolTip.Tip="{Binding Tip}">
                        <DockPanel Margin="4">
                          <Border DockPanel.Dock="Bottom" Background="#99000000" CornerRadius="3" Padding="4,1"
                                  HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Cost}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                          </Border>
                          <TextBlock DockPanel.Dock="Bottom" Text="{Binding Title}" FontSize="11" Foreground="White"
                                     TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                     TextAlignment="Center" Margin="0,2" />
                          <em:RemoteImage Source="{Binding Image}" Width="28" Height="28" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
      <Panel>
        <!-- Emotes show as emotes while typing; Tab completes them. Long
             messages wrap and the box grows (up to a few lines, then
             scrolls); 500 characters is Twitch's limit. -->
        <em:EmoteTextBox x:Name="ChatInput" Text="{Binding Chat.Draft}" IsEnabled="{Binding Chat.CanSend}"
                         PlaceholderText="{Binding Chat.Placeholder}" MinHeight="28" MaxHeight="120" Padding="6,4"
                         TextWrapping="Wrap" MaxLength="500" VerticalContentAlignment="Center"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
        <!-- Signed out, the chat box is a way in rather than a dead end. -->
        <Button x:Name="ChatLogin" Classes="twitch" Content="Log in to chat" Command="{Binding Main.Account.SignInCommand}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Padding="6,4">
          <Button.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="!Main.Account.IsSignedIn" />
              <Binding Path="!Main.Account.IsPending" />
            </MultiBinding>
          </Button.IsVisible>
        </Button>
        <!-- Matching emotes, above the chat box like twitch.tv's. -->
        <Popup x:Name="SuggestionPopup" PlacementTarget="{Binding #ChatInput}" Placement="TopEdgeAlignedLeft"
               IsOpen="{Binding #ChatInput.IsSuggesting}" IsLightDismissEnabled="False">
          <Border Classes="suggestions" MinWidth="{Binding #ChatInput.Bounds.Width}">
            <ListBox x:Name="SuggestionList" Classes="suggestions" Focusable="False" ItemsSource="{Binding #ChatInput.Suggestions}"
                     SelectedIndex="{Binding #ChatInput.SuggestionIndex, Mode=TwoWay}" MaxHeight="300">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="emotes:Emote">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <em:EmoteView Source="{Binding ImageUrl}" EmoteHeight="24" />
                    <TextBlock Text="{Binding Code}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Provider}" VerticalAlignment="Center" Classes="suggestionSource" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </Popup>
      </Panel>
    </DockPanel>
    <!-- Answering a line (its ↩): what's being replied to, above the box. -->
    <Border DockPanel.Dock="Bottom" IsVisible="{Binding Chat.IsReplying}" Margin="4,4,4,0" Padding="8,3"
            CornerRadius="4" Background="#26262C">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding Chat.CancelReplyCommand}" Padding="6,0"
                Background="Transparent" ToolTip.Tip="Cancel the reply" />
        <TextBlock Text="{Binding Chat.ReplyText}" Foreground="{StaticResource SeTextDim}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" FontSize="{StaticResource SeSmallFontSize}" />
      </DockPanel>
    </Border>
    <!-- Shared chat: which channels' chats are mixed in, as twitch.tv says
         above its chat. Each line carries its channel's icon. -->
    <Border Classes="sharedStrip" IsVisible="{Binding Chat.IsShared}" ToolTip.Tip="{Binding Chat.SharedSummary}">
      <DockPanel>
        <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Chat.SharedChannels}" Margin="0,0,8,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="-5" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SharedChannel">
              <Border Classes="sharedAvatar strip" ToolTip.Tip="{Binding Name}">
                <Panel>
                  <TextBlock Text="{Binding Initial}" />
                  <em:RemoteImage Source="{Binding ProfileImage}" Stretch="UniformToFill">
                    <em:RemoteImage.Clip>
                      <EllipseGeometry Rect="0,0,20,20" />
                    </em:RemoteImage.Clip>
                  </em:RemoteImage>
                </Panel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Chat.SharedSummary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
    <Panel>
    <ScrollViewer x:Name="ChatScroll" HorizontalScrollBarVisibility="Disabled">
      <ScrollViewer.ContextMenu>
        <ContextMenu>
          <MenuItem x:Name="UsersInChatItem" Header="Users in chat" IsEnabled="{Binding HasChannel}" />
        </ContextMenu>
      </ScrollViewer.ContextMenu>
      <ItemsControl x:Name="ChatItems" ItemsSource="{Binding Chat.Lines}">
        <ItemsControl.Styles>
          <!-- As on twitch.tv: no zebra rows, a faint highlight under the pointer. -->
          <Style Selector="v|ChatLine:pointerover">
            <Setter Property="Background" Value="#1AFFFFFF" />
          </Style>
        </ItemsControl.Styles>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ChatEntry">
            <v:ChatLine Entry="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <!-- Right-click → Users in chat: covers the lines, as on twitch.tv. -->
    <Panel IsVisible="{Binding ShowsChatters}">
      <v:ChatterListView x:Name="Chatters" DataContext="{Binding Chatters}" />
    </Panel>
    </Panel>
  </DockPanel>
</UserControl>
