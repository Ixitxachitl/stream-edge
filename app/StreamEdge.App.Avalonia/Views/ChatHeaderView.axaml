<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:StreamEdge.AvaloniaApp.Views"
             xmlns:vm="using:StreamEdge.AvaloniaApp.ViewModels"
             x:Class="StreamEdge.AvaloniaApp.Views.ChatHeaderView"
             x:DataType="vm:MainViewModel">
  <!-- The chat pane's one toolbar, across all its chats (side by side or
       stacked): the player's controls, the active chat's mod menu and status,
       and the app's own controls. Dragging it moves the whole pane. -->
  <Border Classes="paneHeader">
    <DockPanel>
      <TextBlock DockPanel.Dock="Left" Classes="dragGrip" Text="⠿" ToolTip.Tip="Drag to move: drop on a side of the video" />
      <!-- The app's own controls: settings beside PIP, always here wherever
           the panes are docked. -->
      <Button DockPanel.Dock="Right" Classes="pip" ToolTip.Tip="Settings">
        <PathIcon Classes="icon" Data="{StaticResource IconGear}" />
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight">
            <v:SettingsView />
          </Flyout>
        </Button.Flyout>
      </Button>
      <ToggleButton DockPanel.Dock="Right" Classes="pip" Content="⧉" IsChecked="{Binding ShowPip}"
                    ToolTip.Tip="Picture-in-picture: background tabs as small videos over the player (off: they pause until you switch to them)" />
      <!-- Which panes show (each moves by dragging its header). -->
      <Button DockPanel.Dock="Right" Classes="pip" Content="▦" ToolTip.Tip="Layout">
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuItem Header="Video" ToggleType="CheckBox" IsChecked="{Binding ShowVideo, Mode=TwoWay}" />
            <MenuItem Header="Live list" ToggleType="CheckBox" IsChecked="{Binding ShowStreamList, Mode=TwoWay}" />
            <MenuItem Header="About panels" ToggleType="CheckBox" IsChecked="{Binding ShowChannelPanel, Mode=TwoWay}" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <!-- Mod menu: only in channels the user moderates (the active chat's). -->
      <Button DockPanel.Dock="Right" x:Name="ModMenuButton" ToolTip.Tip="Moderation"
              IsVisible="{Binding Chat.IsModerator}">
        <PathIcon Classes="icon" Data="{StaticResource IconShield}" />
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight">
            <StackPanel Width="280" Spacing="8" DataContext="{Binding ModMenu}" x:DataType="vm:ModMenuViewModel">
              <TextBlock Text="Chat modes" FontWeight="SemiBold" />
              <ToggleSwitch Content="Slow mode (30 s)" IsChecked="{Binding SlowMode}" />
              <ToggleSwitch Content="Followers only (10 min)" IsChecked="{Binding FollowersOnly}" />
              <ToggleSwitch Content="Subscribers only" IsChecked="{Binding SubscribersOnly}" />
              <ToggleSwitch Content="Emote only" IsChecked="{Binding EmoteOnly}" />
              <ToggleSwitch Content="Unique chat" IsChecked="{Binding UniqueChat}" />
              <ToggleSwitch Content="Shield mode" IsChecked="{Binding ShieldMode}" />
              <Separator />
              <TextBlock Text="Announcement" FontWeight="SemiBold" />
              <TextBox Text="{Binding Announcement}" PlaceholderText="Message" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ComboBox ItemsSource="{Binding AnnouncementColors}" SelectedItem="{Binding AnnouncementColor}" />
                <Button Content="Announce" Command="{Binding AnnounceCommand}" />
              </StackPanel>
              <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource SeAccent}"
                         IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
      <TextBlock DockPanel.Dock="Right" Text="{Binding Chat.Status}" Foreground="{StaticResource SeTextFaint}" Margin="0,0,6,0" />
      <!-- Player controls live here: nothing can be drawn over native video. -->
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" Margin="0,0,8,0">
        <StackPanel.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="HasChannel" />
            <Binding Path="Player.IsVideoVisible" />
          </MultiBinding>
        </StackPanel.IsVisible>
        <TextBlock Text="{Binding Player.Speed}" Foreground="{StaticResource SeAccent}"
                   ToolTip.Tip="Playing faster to catch up to live" Margin="0,0,4,0" />
        <TextBlock Text="{Binding Player.Latency}" Foreground="{StaticResource SeTextDim}"
                   ToolTip.Tip="Approximate delay behind the broadcaster" Margin="0,0,4,0" />
        <ToggleButton Classes="cc" Content="CC" IsChecked="{Binding Player.Captions}" ToolTip.Tip="Closed captions (when the stream has them)" />
        <Button Content="{Binding Player.QualityLabel}" ToolTip.Tip="Quality (drops automatically to keep up with live)">
          <Button.Flyout>
            <MenuFlyout ItemsSource="{Binding Qualities}">
              <MenuFlyout.ItemContainerTheme>
                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:QualityOption">
                  <Setter Property="Header" Value="{Binding Name}" />
                  <Setter Property="Command" Value="{Binding Select}" />
                  <Setter Property="CommandParameter" Value="{Binding}" />
                  <Setter Property="ToggleType" Value="Radio" />
                  <Setter Property="IsChecked" Value="{Binding IsCurrent}" />
                </ControlTheme>
              </MenuFlyout.ItemContainerTheme>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
      <!-- Channel names, mute and close are on the tabs. -->
      <Panel />
    </DockPanel>
  </Border>
</UserControl>
