<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:v="using:StreamEdge.AvaloniaApp.Views"
        xmlns:em="using:StreamEdge.AvaloniaApp.Views.Emotes"
        xmlns:vm="using:StreamEdge.AvaloniaApp.ViewModels"
        xmlns:streams="using:StreamEdge.Streams"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="480"
        x:Class="StreamEdge.AvaloniaApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Icon="avares://StreamEdge/Assets/icon.ico"
        Width="1920" Height="480" MinWidth="{Binding MinWindowWidth}" MinHeight="240">

  <Panel>
  <!-- Chat, the live list and the channel panel each dock to a side of the
       video, wherever they were left (dragged there by their headers). -->
  <v:UltrawideLayout x:Name="Layout" ChatShare="{Binding ChatShare}" VideoOnly="{Binding VideoOnly}"
                    ShowList="{Binding ShowStreamList}" ShowPanel="{Binding ShowChannelPanel}"
                    ChatPlace="{Binding ChatPlace}" ListPlace="{Binding ListPlace}" PanelPlace="{Binding PanelPlace}"
                    TopRowShare="{Binding TopRowShare}" BottomRowShare="{Binding BottomRowShare}"
                    Background="{StaticResource SeWindowBg}">

    <!-- ===== Chat ===== -->
    <!-- One or more chats, side by side or stacked, and the layer that
         shows where a dragged tab will land. -->
    <!-- Each pane is a rounded card (Border.pane) floating on the window's
         dark ground, with the gaps between them as the drag lines. -->
    <Border x:Name="ChatPane" Classes="pane">
    <Panel>
      <ItemsControl x:Name="ChatColumns" ItemsSource="{Binding Columns}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <!-- The dark ground shows only in the gaps between stacked chats. -->
            <v:ChatSplitPanel Background="{StaticResource SeWindowBg}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ChatColumnViewModel">
            <v:ChatColumnView />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Canvas x:Name="DropLayer" IsHitTestVisible="False">
        <Border x:Name="DropIndicator" Classes="dropIndicator" IsVisible="False" />
      </Canvas>
    </Panel>
    </Border>

    <!-- ===== Player ===== -->
    <Border x:Name="PlayerPane" Classes="pane" Background="Black">
    <Panel>
      <!-- Offline: the channel's own offline banner, as on twitch.tv. -->
      <em:RemoteImage Source="{Binding Player.OfflineImage}" IsVisible="{Binding Player.ShowsBanner}" />
      <!-- Shown when there's no video: what's selected and why it isn't
           playing. Over a banner it moves to the bottom-left on a backdrop. -->
      <StackPanel Classes="playerInfo" Spacing="6" MaxWidth="600"
                  Classes.overBanner="{Binding Player.ShowsBanner}">
        <em:RemoteImage Source="{Binding Player.ProfileImage}" Width="88" Height="88" Stretch="UniformToFill"
                        HorizontalAlignment="Center" Margin="0,0,0,4">
          <em:RemoteImage.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="Player.IsOffline" />
              <Binding Path="!Player.HasOfflineImage" />
            </MultiBinding>
          </em:RemoteImage.IsVisible>
          <em:RemoteImage.Clip>
            <EllipseGeometry Rect="0,0,88,88" />
          </em:RemoteImage.Clip>
        </em:RemoteImage>
        <TextBlock Text="{Binding Player.Channel}" FontSize="22" FontWeight="SemiBold"
                   Foreground="{StaticResource SeText}" />
        <TextBlock Text="{Binding Player.Title}" IsVisible="{Binding Player.Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{StaticResource SeTextDim}"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding Player.Game}" IsVisible="{Binding Player.Game, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{StaticResource SeAccent}" />
        <TextBlock Text="{Binding Player.Status}" Foreground="{StaticResource SeTextFaint}"
                   FontSize="{StaticResource SeSmallFontSize}" TextWrapping="Wrap" />
      </StackPanel>
      <!-- One native video surface per tab (added in code): the front one
           fills the pane at 16:9 and covers the text above while playing;
           the others are PIP thumbnails or hidden. -->
      <v:VideoStage x:Name="Videos" ShowPip="{Binding ShowPip}" />
      <!-- While a pane is dragged by its header: where it can dock. The
           videos step aside (they can't be drawn over) and come back on drop. -->
      <Grid x:Name="DockTargets" IsVisible="False" ColumnDefinitions="3*,4*,3*" RowDefinitions="*,*" Margin="8">
        <Border x:Name="DockLeft" Classes="dockTarget" Grid.RowSpan="2"><TextBlock Text="◀ Left" /></Border>
        <Border x:Name="DockTop" Classes="dockTarget" Grid.Column="1"><TextBlock Text="▲ Above" /></Border>
        <Border x:Name="DockBottom" Classes="dockTarget" Grid.Column="1" Grid.Row="1"><TextBlock Text="▼ Below" /></Border>
        <Border x:Name="DockRight" Classes="dockTarget" Grid.Column="2" Grid.RowSpan="2"><TextBlock Text="Right ▶" /></Border>
      </Grid>
    </Panel>
    </Border>

    <!-- ===== Live streams ===== -->
    <v:StreamListView x:Name="StreamsPane" IsVisible="{Binding ShowStreamList}" />


    <!-- Drag handles either side of the player (left, then right). -->
    <v:PaneGrip x:Name="LeftGrip" Classes="grip" />
    <v:PaneGrip x:Name="RightGrip" Classes="grip" />

    <!-- ===== Channel panel (About) ===== -->
    <v:ChannelPanelView x:Name="ChannelPanelPane" IsVisible="{Binding ShowChannelPanel}" />

  </v:UltrawideLayout>

  <!-- Dragging a pane by its header: where it will land, drawn where the
       layout would put it (over the stepped-aside video too). -->
  <Canvas x:Name="DockOverlay" IsHitTestVisible="False">
    <Border x:Name="DockPreview" Classes="dockPreview" IsVisible="False" />
  </Canvas>

  <!-- Go-live and whisper alerts, top right (added in code). -->
  <StackPanel x:Name="Alerts" Classes="alerts" />
  </Panel>
</Window>
