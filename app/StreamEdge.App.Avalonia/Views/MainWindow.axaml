<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:v="using:StreamEdge.AvaloniaApp.Views"
        xmlns:em="using:StreamEdge.AvaloniaApp.Views.Emotes"
        xmlns:vm="using:StreamEdge.AvaloniaApp.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="480"
        x:Class="StreamEdge.AvaloniaApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Icon="avares://StreamEdge/Assets/icon.ico"
        Width="1920" Height="480" MinWidth="960" MinHeight="240">

  <v:UltrawideLayout x:Name="Layout" ChatShare="{Binding ChatShare}" ChatOnLeft="{Binding ChatOnLeft}">

    <!-- ===== Chat ===== -->
    <DockPanel x:Name="ChatPane" Background="{StaticResource SePanelBg}">
      <!-- Open channels. Selecting one brings its video and chat to the front;
           the rest keep playing (audio, or as PIP thumbnails). -->
      <Border DockPanel.Dock="Top" Classes="tabStrip" IsVisible="{Binding HasTabs}">
        <DockPanel>
          <ToggleButton DockPanel.Dock="Right" Classes="pip" Content="⧉ PIP" IsChecked="{Binding ShowPip}"
                        ToolTip.Tip="Show background tabs as small videos over the player (off: audio only)" />
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Tabs}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChannelTabViewModel">
                  <Border Classes="tab" Classes.front="{Binding IsFront}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <Button Classes="tabName" Content="{Binding Title}" Command="{Binding SelectCommand}"
                              ToolTip.Tip="Bring to front" />
                      <Button Classes="tabIcon" Content="{Binding Player.MuteGlyph}" Command="{Binding Player.ToggleMuteCommand}"
                              ToolTip.Tip="Mute this tab" />
                      <Button Classes="tabIcon" Content="✕" Command="{Binding CloseCommand}" ToolTip.Tip="Close tab" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <Border DockPanel.Dock="Top" Classes="paneHeader">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="✕" ToolTip.Tip="Leave channel"
                  Command="{Binding LeaveChannelCommand}" IsVisible="{Binding HasChannel}" />
          <!-- Mod menu: only in channels the user moderates. -->
          <Button DockPanel.Dock="Right" x:Name="ModMenuButton" Content="🛡" ToolTip.Tip="Moderation"
                  IsVisible="{Binding Chat.IsModerator}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="280" Spacing="8" DataContext="{Binding ModMenu}" x:DataType="vm:ModMenuViewModel">
                  <TextBlock Text="Chat modes" FontWeight="SemiBold" />
                  <ToggleSwitch Content="Slow mode (30 s)" IsChecked="{Binding SlowMode}" />
                  <ToggleSwitch Content="Followers only (10 min)" IsChecked="{Binding FollowersOnly}" />
                  <ToggleSwitch Content="Subscribers only" IsChecked="{Binding SubscribersOnly}" />
                  <ToggleSwitch Content="Emote only" IsChecked="{Binding EmoteOnly}" />
                  <ToggleSwitch Content="Unique chat" IsChecked="{Binding UniqueChat}" />
                  <ToggleSwitch Content="Shield mode" IsChecked="{Binding ShieldMode}" />
                  <Separator />
                  <TextBlock Text="Announcement" FontWeight="SemiBold" />
                  <TextBox Text="{Binding Announcement}" PlaceholderText="Message" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ComboBox ItemsSource="{Binding AnnouncementColors}" SelectedItem="{Binding AnnouncementColor}" />
                    <Button Content="Announce" Command="{Binding AnnounceCommand}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource SeAccent}"
                             IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Chat.Status}" Foreground="{StaticResource SeTextFaint}" Margin="0,0,6,0" />
          <!-- Player controls live here: nothing can be drawn over native video. -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" Margin="0,0,8,0"
                      IsVisible="{Binding Player.IsVideoVisible}">
            <TextBlock Text="{Binding Player.Speed}" Foreground="{StaticResource SeAccent}"
                       ToolTip.Tip="Playing faster to catch up to live" Margin="0,0,4,0" />
            <TextBlock Text="{Binding Player.Latency}" Foreground="{StaticResource SeTextDim}"
                       ToolTip.Tip="Approximate delay behind the broadcaster" Margin="0,0,4,0" />
            <ToggleButton Classes="cc" Content="CC" IsChecked="{Binding Player.Captions}" ToolTip.Tip="Closed captions (when the stream has them)" />
            <Button Content="{Binding Player.MuteGlyph}" Command="{Binding Player.ToggleMuteCommand}" ToolTip.Tip="Mute" />
            <Button Content="{Binding Player.QualityLabel}" ToolTip.Tip="Quality (drops automatically to keep up with live)">
              <Button.Flyout>
                <MenuFlyout ItemsSource="{Binding Player.Qualities}">
                  <MenuFlyout.ItemContainerTheme>
                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:QualityOption">
                      <Setter Property="Header" Value="{Binding Name}" />
                      <Setter Property="Command" Value="{Binding Select}" />
                      <Setter Property="CommandParameter" Value="{Binding}" />
                      <Setter Property="ToggleType" Value="Radio" />
                      <Setter Property="IsChecked" Value="{Binding IsCurrent}" />
                    </ControlTheme>
                  </MenuFlyout.ItemContainerTheme>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
          <TextBlock Text="{Binding Chat.Header}" FontWeight="SemiBold" Foreground="{StaticResource SeText}" />
        </DockPanel>
      </Border>
      <DockPanel DockPanel.Dock="Bottom" Margin="4">
        <!-- Emote menu, like twitch.tv's smiley in the chat box. -->
        <Button DockPanel.Dock="Right" x:Name="EmoteButton" Classes="emoteMenu" Content="☺"
                ToolTip.Tip="Emotes" Margin="4,0,0,0">
          <Button.Flyout>
            <Flyout Placement="TopEdgeAlignedRight">
              <DockPanel Width="344" DataContext="{Binding EmoteMenu}" x:DataType="vm:EmoteMenuViewModel">
                <TextBox DockPanel.Dock="Top" x:Name="EmoteSearch" Text="{Binding Search}" PlaceholderText="Search emotes" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding Notice}" TextWrapping="Wrap" Margin="2,6"
                           Foreground="{StaticResource SeTextDim}" FontSize="{StaticResource SeSmallFontSize}"
                           IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ListBox ItemsSource="{Binding Rows}" Classes="emoteRows" Height="300" Margin="0,6,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.DataTemplates>
                    <DataTemplate DataType="vm:EmoteMenuHeader">
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,8,0,2">
                        <em:RemoteImage Source="{Binding Icon}" Width="18" Height="18"
                                        IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}">
                          <em:RemoteImage.Clip>
                            <EllipseGeometry Rect="0,0,18,18" />
                          </em:RemoteImage.Clip>
                        </em:RemoteImage>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource SeSmallFontSize}"
                                   Foreground="{StaticResource SeTextDim}" />
                      </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="vm:EmoteMenuEmotes">
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:EmoteMenuItem">
                            <Button Classes="emoteCell" Command="{Binding Insert}" CommandParameter="{Binding Emote}"
                                    ToolTip.Tip="{Binding Tip}">
                              <em:EmoteView Source="{Binding Emote.ImageUrl}" EmoteHeight="28" />
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </DataTemplate>
                  </ListBox.DataTemplates>
                </ListBox>
              </DockPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <TextBox x:Name="ChatInput" Text="{Binding Chat.Draft}" IsEnabled="{Binding Chat.CanSend}"
                 PlaceholderText="{Binding Chat.Placeholder}" MinHeight="28" Padding="6,4" />
      </DockPanel>
      <ScrollViewer x:Name="ChatScroll" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="ChatItems" ItemsSource="{Binding Chat.Lines}">
          <ItemsControl.Styles>
            <!-- As on twitch.tv: no zebra rows, a faint highlight under the pointer. -->
            <Style Selector="v|ChatLine:pointerover">
              <Setter Property="Background" Value="#1AFFFFFF" />
            </Style>
          </ItemsControl.Styles>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatEntry">
              <v:ChatLine Entry="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- ===== Player ===== -->
    <Panel x:Name="PlayerPane" Background="Black">
      <!-- Offline: the channel's own offline banner, as on twitch.tv. -->
      <em:RemoteImage Source="{Binding Player.OfflineImage}" IsVisible="{Binding Player.ShowsBanner}" />
      <!-- Shown when there's no video: what's selected and why it isn't
           playing. Over a banner it moves to the bottom-left on a backdrop. -->
      <StackPanel Classes="playerInfo" Spacing="6" MaxWidth="600"
                  Classes.overBanner="{Binding Player.ShowsBanner}">
        <em:RemoteImage Source="{Binding Player.ProfileImage}" Width="88" Height="88" Stretch="UniformToFill"
                        HorizontalAlignment="Center" Margin="0,0,0,4">
          <em:RemoteImage.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="Player.IsOffline" />
              <Binding Path="!Player.HasOfflineImage" />
            </MultiBinding>
          </em:RemoteImage.IsVisible>
          <em:RemoteImage.Clip>
            <EllipseGeometry Rect="0,0,88,88" />
          </em:RemoteImage.Clip>
        </em:RemoteImage>
        <TextBlock Text="{Binding Player.Channel}" FontSize="22" FontWeight="SemiBold"
                   Foreground="{StaticResource SeText}" />
        <TextBlock Text="{Binding Player.Title}" IsVisible="{Binding Player.Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{StaticResource SeTextDim}"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding Player.Game}" IsVisible="{Binding Player.Game, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{StaticResource SeAccent}" />
        <TextBlock Text="{Binding Player.Status}" Foreground="{StaticResource SeTextFaint}"
                   FontSize="{StaticResource SeSmallFontSize}" TextWrapping="Wrap" />
      </StackPanel>
      <!-- One native video surface per tab (added in code): the front one
           fills the pane at 16:9 and covers the text above while playing;
           the others are PIP thumbnails or hidden. -->
      <v:VideoStage x:Name="Videos" ShowPip="{Binding ShowPip}" />
    </Panel>

    <!-- ===== Live streams ===== -->
    <DockPanel x:Name="StreamsPane" Background="{StaticResource SePanelBg}">
      <Border DockPanel.Dock="Top" Classes="paneHeader">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="⚙" ToolTip.Tip="Settings">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <!-- Taller than a bar display: scroll rather than clip. -->
                <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Width="320" Spacing="8" Margin="0,0,12,0">
                <TextBlock Text="Layout and startup" FontWeight="SemiBold" />
                <CheckBox Content="Chat on the left (stream list on the right)" IsChecked="{Binding ChatOnLeft}" />
                <CheckBox Content="Reopen the last tabs at startup" IsChecked="{Binding ReopenLastChannel}" />
                <CheckBox Content="Show background tabs as picture-in-picture" IsChecked="{Binding ShowPip}" />
                <Separator />
                <TextBlock Text="Chat" FontWeight="SemiBold" />
                <CheckBox Content="Timestamps" IsChecked="{Binding ShowTimestamps}" />
                <CheckBox Content="Join and part messages" IsChecked="{Binding ShowJoinPart}" />
                <CheckBox Content="Chat history when a channel opens" IsChecked="{Binding LoadChatHistory}"
                          ToolTip.Tip="Twitch's own history needs the auth-token (below)" />
                <TextBlock Text="Third-party (each optional)" Foreground="{StaticResource SeTextDim}" FontSize="{StaticResource SeSmallFontSize}" />
                <CheckBox Content="Pronouns (pronouns.alejo.io)" IsChecked="{Binding ShowPronouns}" />
                <CheckBox Content="BetterTTV emotes" IsChecked="{Binding UseBttv}" />
                <CheckBox Content="FrankerFaceZ emotes and badges" IsChecked="{Binding UseFfz}" />
                <CheckBox Content="7TV emotes" IsChecked="{Binding UseSevenTv}" />
                <CheckBox Content="History without an auth-token (recent-messages.robotty.de)" IsChecked="{Binding UseRecentMessages}" />
                <Separator />
                <StackPanel Spacing="8" DataContext="{Binding Account}" x:DataType="vm:AccountViewModel">
                  <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
                  <v:LoginBox IsVisible="{Binding !IsSignedIn}" />
                  <Button Content="Log out" Command="{Binding SignOutCommand}" IsVisible="{Binding IsSignedIn}" />
                  <Separator />
                  <TextBlock Text="Ad-free playback (optional)" FontWeight="SemiBold" />
                  <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SeTextDim}" FontSize="{StaticResource SeSmallFontSize}"
                             Text="Paste the auth-token cookie from a browser signed in to twitch.tv. It is stored encrypted and sent only to gql.twitch.tv when resolving a stream." />
                  <TextBox Text="{Binding PlaybackTokenDraft}" PasswordChar="•" PlaceholderText="auth-token" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Save token" Command="{Binding SavePlaybackTokenCommand}" />
                    <Button Content="Clear" Command="{Binding ClearPlaybackTokenCommand}" IsEnabled="{Binding HasPlaybackToken}" />
                    <TextBlock Text="✓ token set" Foreground="{StaticResource SeAccent}" VerticalAlignment="Center"
                               IsVisible="{Binding HasPlaybackToken}" />
                  </StackPanel>
                </StackPanel>
                </StackPanel>
                </ScrollViewer>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button DockPanel.Dock="Right" Content="⇅" ToolTip.Tip="Change sort" Command="{Binding Streams.CycleSortCommand}" />
          <Button DockPanel.Dock="Right" Content="⟳" ToolTip.Tip="Refresh the live list (and retry offline tabs)" Command="{Binding RefreshCommand}" />
          <TextBlock Text="{Binding Streams.Header}" />
        </DockPanel>
      </Border>
      <Panel>
        <StackPanel IsVisible="{Binding Streams.IsEmpty}" VerticalAlignment="Center" Margin="16" Spacing="10">
          <TextBlock Text="{Binding Streams.EmptyText}" Foreground="{StaticResource SeTextFaint}"
                     TextWrapping="Wrap" TextAlignment="Center" />
          <!-- The login screen: shown in place of the list until signed in. -->
          <v:LoginBox DataContext="{Binding Account}" IsVisible="{Binding !IsSignedIn}" HorizontalAlignment="Center" />
        </StackPanel>
        <ListBox x:Name="StreamList" ItemsSource="{Binding Streams.Items}" SelectedItem="{Binding Streams.Selected}"
                 Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="8,4" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:StreamItemViewModel">
              <StackPanel Spacing="1" Background="Transparent">
                <StackPanel.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Open" Command="{Binding OpenCommand}" />
                    <MenuItem Header="Open in new tab" Command="{Binding OpenInNewTabCommand}" />
                    <MenuItem Header="Open in background tab (keeps playing)" Command="{Binding OpenInBackgroundCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding FavoriteMenuText}" Command="{Binding ToggleFavoriteCommand}" />
                  </ContextMenu>
                </StackPanel.ContextMenu>
                <!-- ──── ★ Name (viewers | uptime) ──── -->
                <Grid ColumnDefinitions="*,Auto,*">
                  <Rectangle Height="1" Fill="{StaticResource SeRule}" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <!-- Click to star: starred channels sort to the top. A
                         button, so clicking it doesn't also open the channel. -->
                    <Button Classes="star" Classes.on="{Binding IsFavorite}" Content="{Binding FavoriteGlyph}"
                            Command="{Binding ToggleFavoriteCommand}" ToolTip.Tip="{Binding FavoriteMenuText}" />
                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Foreground="{StaticResource SeText}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource SeRule}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </Grid>
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="{StaticResource SeText}" />
                <TextBlock Text="{Binding Game}" Foreground="{StaticResource SeTextDim}" FontSize="{StaticResource SeSmallFontSize}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Panel>
    </DockPanel>


    <!-- Drag handles either side of the player (left, then right). -->
    <v:PaneGrip x:Name="LeftGrip" Classes="grip" />
    <v:PaneGrip x:Name="RightGrip" Classes="grip" />

  </v:UltrawideLayout>
</Window>
