<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:v="using:StreamEdge.AvaloniaApp.Views"
        xmlns:em="using:StreamEdge.AvaloniaApp.Views.Emotes"
        xmlns:vm="using:StreamEdge.AvaloniaApp.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="480"
        x:Class="StreamEdge.AvaloniaApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Icon="avares://StreamEdge/Assets/icon.ico"
        Width="1920" Height="480" MinWidth="960" MinHeight="240">

  <v:UltrawideLayout x:Name="Layout" ChatShare="{Binding ChatShare}" ChatOnLeft="{Binding ChatOnLeft}"
                    VideoOnly="{Binding VideoOnly}">

    <!-- ===== Chat ===== -->
    <!-- One or more chat columns side by side, and the layer that shows
         where a dragged tab will land. -->
    <Panel x:Name="ChatPane" Background="{StaticResource SePanelBg}">
      <ItemsControl x:Name="ChatColumns" ItemsSource="{Binding Columns}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ChatColumnViewModel">
            <v:ChatColumnView />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Canvas x:Name="DropLayer" IsHitTestVisible="False">
        <Border x:Name="DropIndicator" Classes="dropIndicator" IsVisible="False" />
      </Canvas>
    </Panel>

    <!-- ===== Player ===== -->
    <Panel x:Name="PlayerPane" Background="Black">
      <!-- Offline: the channel's own offline banner, as on twitch.tv. -->
      <em:RemoteImage Source="{Binding Player.OfflineImage}" IsVisible="{Binding Player.ShowsBanner}" />
      <!-- Shown when there's no video: what's selected and why it isn't
           playing. Over a banner it moves to the bottom-left on a backdrop. -->
      <StackPanel Classes="playerInfo" Spacing="6" MaxWidth="600"
                  Classes.overBanner="{Binding Player.ShowsBanner}">
        <em:RemoteImage Source="{Binding Player.ProfileImage}" Width="88" Height="88" Stretch="UniformToFill"
                        HorizontalAlignment="Center" Margin="0,0,0,4">
          <em:RemoteImage.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="Player.IsOffline" />
              <Binding Path="!Player.HasOfflineImage" />
            </MultiBinding>
          </em:RemoteImage.IsVisible>
          <em:RemoteImage.Clip>
            <EllipseGeometry Rect="0,0,88,88" />
          </em:RemoteImage.Clip>
        </em:RemoteImage>
        <TextBlock Text="{Binding Player.Channel}" FontSize="22" FontWeight="SemiBold"
                   Foreground="{StaticResource SeText}" />
        <TextBlock Text="{Binding Player.Title}" IsVisible="{Binding Player.Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{StaticResource SeTextDim}"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding Player.Game}" IsVisible="{Binding Player.Game, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{StaticResource SeAccent}" />
        <TextBlock Text="{Binding Player.Status}" Foreground="{StaticResource SeTextFaint}"
                   FontSize="{StaticResource SeSmallFontSize}" TextWrapping="Wrap" />
      </StackPanel>
      <!-- One native video surface per tab (added in code): the front one
           fills the pane at 16:9 and covers the text above while playing;
           the others are PIP thumbnails or hidden. -->
      <v:VideoStage x:Name="Videos" ShowPip="{Binding ShowPip}" />
    </Panel>

    <!-- ===== Live streams ===== -->
    <DockPanel x:Name="StreamsPane" Background="{StaticResource SePanelBg}">
      <Border DockPanel.Dock="Top" Classes="paneHeader">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="⚙" ToolTip.Tip="Settings">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <!-- Taller than a bar display: scroll rather than clip. -->
                <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Width="320" Spacing="8" Margin="0,0,12,0">
                <TextBlock Text="Layout and startup" FontWeight="SemiBold" />
                <CheckBox Content="Chat on the left (stream list on the right)" IsChecked="{Binding ChatOnLeft}" />
                <CheckBox Content="Reopen the last tabs at startup" IsChecked="{Binding ReopenLastChannel}" />
                <CheckBox Content="Show background tabs as picture-in-picture" IsChecked="{Binding ShowPip}" />
                <Separator />
                <TextBlock Text="Chat" FontWeight="SemiBold" />
                <CheckBox Content="Timestamps" IsChecked="{Binding ShowTimestamps}" />
                <CheckBox Content="Join and part messages" IsChecked="{Binding ShowJoinPart}" />
                <CheckBox Content="Chat history when a channel opens" IsChecked="{Binding LoadChatHistory}"
                          ToolTip.Tip="Twitch's own history needs the auth-token (below)" />
                <TextBlock Text="Third-party (each optional)" Foreground="{StaticResource SeTextDim}" FontSize="{StaticResource SeSmallFontSize}" />
                <CheckBox Content="Pronouns (pronouns.alejo.io)" IsChecked="{Binding ShowPronouns}" />
                <CheckBox Content="BetterTTV emotes" IsChecked="{Binding UseBttv}" />
                <CheckBox Content="FrankerFaceZ emotes and badges" IsChecked="{Binding UseFfz}" />
                <CheckBox Content="7TV emotes" IsChecked="{Binding UseSevenTv}" />
                <CheckBox Content="History without an auth-token (recent-messages.robotty.de)" IsChecked="{Binding UseRecentMessages}" />
                <Separator />
                <StackPanel Spacing="8" DataContext="{Binding Account}" x:DataType="vm:AccountViewModel">
                  <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
                  <v:LoginBox IsVisible="{Binding !IsSignedIn}" />
                  <Button Content="Log out" Command="{Binding SignOutCommand}" IsVisible="{Binding IsSignedIn}" />
                  <Separator />
                  <TextBlock Text="Ad-free playback (optional)" FontWeight="SemiBold" />
                  <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SeTextDim}" FontSize="{StaticResource SeSmallFontSize}"
                             Text="Paste the auth-token cookie from a browser signed in to twitch.tv. It is stored encrypted and sent only to gql.twitch.tv when resolving a stream." />
                  <TextBox Text="{Binding PlaybackTokenDraft}" PasswordChar="•" PlaceholderText="auth-token" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="Save token" Command="{Binding SavePlaybackTokenCommand}" />
                    <Button Content="Clear" Command="{Binding ClearPlaybackTokenCommand}" IsEnabled="{Binding HasPlaybackToken}" />
                    <TextBlock Text="✓ token set" Foreground="{StaticResource SeAccent}" VerticalAlignment="Center"
                               IsVisible="{Binding HasPlaybackToken}" />
                  </StackPanel>
                </StackPanel>
                </StackPanel>
                </ScrollViewer>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button DockPanel.Dock="Right" Content="⇅" ToolTip.Tip="Change sort" Command="{Binding Streams.CycleSortCommand}" />
          <Button DockPanel.Dock="Right" Content="⟳" ToolTip.Tip="Refresh the live list (and retry offline tabs)" Command="{Binding RefreshCommand}" />
          <TextBlock Text="{Binding Streams.Header}" />
        </DockPanel>
      </Border>
      <Panel>
        <StackPanel IsVisible="{Binding Streams.IsEmpty}" VerticalAlignment="Center" Margin="16" Spacing="10">
          <TextBlock Text="{Binding Streams.EmptyText}" Foreground="{StaticResource SeTextFaint}"
                     TextWrapping="Wrap" TextAlignment="Center" />
          <!-- The login screen: shown in place of the list until signed in. -->
          <v:LoginBox DataContext="{Binding Account}" IsVisible="{Binding !IsSignedIn}" HorizontalAlignment="Center" />
        </StackPanel>
        <ListBox x:Name="StreamList" ItemsSource="{Binding Streams.Items}" SelectedItem="{Binding Streams.Selected}"
                 Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="8,4" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:StreamItemViewModel">
              <StackPanel Spacing="1" Background="Transparent">
                <StackPanel.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Open" Command="{Binding OpenCommand}" />
                    <MenuItem Header="Open in new tab" Command="{Binding OpenInNewTabCommand}" />
                    <MenuItem Header="Open in background tab (keeps playing)" Command="{Binding OpenInBackgroundCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding FavoriteMenuText}" Command="{Binding ToggleFavoriteCommand}" />
                  </ContextMenu>
                </StackPanel.ContextMenu>
                <!-- ──── ★ Name (viewers | uptime) ──── -->
                <Grid ColumnDefinitions="*,Auto,*">
                  <Rectangle Height="1" Fill="{StaticResource SeRule}" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <!-- Click to star: starred channels sort to the top. A
                         button, so clicking it doesn't also open the channel. -->
                    <Button Classes="star" Classes.on="{Binding IsFavorite}" Content="{Binding FavoriteGlyph}"
                            Command="{Binding ToggleFavoriteCommand}" ToolTip.Tip="{Binding FavoriteMenuText}" />
                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Foreground="{StaticResource SeText}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource SeRule}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </Grid>
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="{StaticResource SeText}" />
                <TextBlock Text="{Binding Game}" Foreground="{StaticResource SeTextDim}" FontSize="{StaticResource SeSmallFontSize}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Panel>
    </DockPanel>


    <!-- Drag handles either side of the player (left, then right). -->
    <v:PaneGrip x:Name="LeftGrip" Classes="grip" />
    <v:PaneGrip x:Name="RightGrip" Classes="grip" />

  </v:UltrawideLayout>
</Window>
