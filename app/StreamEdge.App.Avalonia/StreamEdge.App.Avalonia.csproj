<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>StreamEdge.AvaloniaApp</RootNamespace>
    <AssemblyName>StreamEdge</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Published builds drop the parts of .NET and the libraries the app
         never calls (about a third of the download). What it reads as JSON
         goes through generated code (JsonSerializerContext), which trimming
         can't break; reflection-based JSON would be flagged here. .NET's
         built-in COM is off: nothing uses it (Avalonia has its own), and it
         can't be trimmed safely. -->
    <PublishTrimmed>true</PublishTrimmed>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Windows PE icon for the executable; the same art is an
         AvaloniaResource below for the window and taskbar on every OS.
         Regenerate both from /icon.png with scripts/make-icon.ps1. -->
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <!-- LibraryImport (PlayerSurface's window z-order calls). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StreamEdge.Core\StreamEdge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/icon.ico" />
    <AvaloniaResource Include="Assets/icon.png" />
  </ItemGroup>

  <!-- libmpv for the player, on Windows only: Linux and macOS use the system
       package. Fetched by scripts/fetch-libmpv.ps1 (-Arch x86 for the 32-bit
       build); optional, since the app runs without it (the player pane says
       what's missing). Plain builds use the 64-bit one. -->
  <PropertyGroup>
    <LibmpvDir>win-x64</LibmpvDir>
    <LibmpvDir Condition="'$(RuntimeIdentifier)' == 'win-x86'">win-x86</LibmpvDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\third_party\libmpv\$(LibmpvDir)\libmpv-2.dll')">
    <None Include="..\..\third_party\libmpv\$(LibmpvDir)\libmpv-2.dll" Link="libmpv-2.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- SkiaSharp's and HarfBuzzSharp's Windows packages ship native debug
       symbols (~100 MB together) that are only useful for stepping through
       their C++. Dropped at publish only; local builds keep everything. -->
  <Target Name="PruneThirdPartyNativeSymbols" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(Extension)' == '.pdb' And ('%(Filename)' == 'libSkiaSharp' Or '%(Filename)' == 'libHarfBuzzSharp')" />
    </ItemGroup>
  </Target>

</Project>
