<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>StreamEdge.AvaloniaApp</RootNamespace>
    <AssemblyName>StreamEdge</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- LibraryImport (PlayerSurface's window z-order calls). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StreamEdge.Core\StreamEdge.Core.csproj" />
  </ItemGroup>

  <!-- libmpv for the player, on Windows only: Linux and macOS use the system
       package. Fetched by scripts/fetch-libmpv.ps1; optional, since the app
       runs without it (the player pane says what's missing). -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\third_party\libmpv\win-x64\libmpv-2.dll')">
    <None Include="..\..\third_party\libmpv\win-x64\libmpv-2.dll" Link="libmpv-2.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- SkiaSharp's and HarfBuzzSharp's Windows packages ship native debug
       symbols (~100 MB together) that are only useful for stepping through
       their C++. Dropped at publish only; local builds keep everything. -->
  <Target Name="PruneThirdPartyNativeSymbols" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(Extension)' == '.pdb' And ('%(Filename)' == 'libSkiaSharp' Or '%(Filename)' == 'libHarfBuzzSharp')" />
    </ItemGroup>
  </Target>

</Project>
